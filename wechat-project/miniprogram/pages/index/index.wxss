.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  background:
    radial-gradient(circle at top, rgba(254, 243, 199, 0.95), rgba(248, 250, 252, 0) 42%),
    linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);
}

.backdrop {
  position: fixed;
  border-radius: 999rpx;
  filter: blur(12rpx);
  opacity: 0.32;
  pointer-events: none;
}

.backdrop-one {
  top: 120rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  background: #fde68a;
}

.backdrop-two {
  top: 520rpx;
  left: -100rpx;
  width: 280rpx;
  height: 280rpx;
  background: #bfdbfe;
}

.hero,
.nav-card,
.card,
.overview-card,
.feature-card {
  position: relative;
  z-index: 1;
}

.hero {
  background: linear-gradient(135deg, #fff7ed, #e0f2fe);
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 24rpx 56rpx rgba(15, 23, 42, 0.08);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.hero-copy {
  flex: 1;
}

.hero-eyebrow,
.section-eyebrow {
  color: #64748b;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #0f172a;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.6;
}

.hero-badge {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-status {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.hero-status-item {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.hero-status-label {
  color: #64748b;
  font-size: 22rpx;
}

.hero-status-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.nav-card,
.overview-card,
.card,
.feature-card {
  margin-top: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(10rpx);
}

.feature-warm {
  background: linear-gradient(180deg, rgba(255, 251, 235, 0.96), rgba(255, 255, 255, 0.96));
}

.feature-cool {
  background: linear-gradient(180deg, rgba(236, 254, 255, 0.96), rgba(255, 255, 255, 0.96));
}

.soft-card {
  background: linear-gradient(180deg, #fffdf7, #f8fbff);
}

.premium-card {
  border-color: rgba(226, 232, 240, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.07);
}

.nav-head,
.feature-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.nav-title,
.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #0f172a;
}

.nav-meta,
.section-desc {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.feature-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 700;
}

.feature-tag.cool {
  background: #cffafe;
  color: #0f766e;
}

.tab-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.tab-row {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.tab-pill {
  flex-shrink: 0;
  min-width: 144rpx;
  padding: 18rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 26rpx;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.04);
}

.tab-pill.active {
  background: linear-gradient(135deg, #fff1d6, #e0f2fe);
  border-color: #fb923c;
  color: #0f172a;
  box-shadow: 0 16rpx 30rpx rgba(251, 146, 60, 0.14);
}

.section-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: 36rpx;
}

.overview-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.overview-item {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fffaf5, #ffffff);
  border: 1rpx solid #e2e8f0;
  text-align: center;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}

.overview-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.primary-btn,
.ghost-btn {
  width: 100%;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 90rpx;
  margin-top: 14rpx;
}

.primary-btn {
  background: #fb923c;
  color: #ffffff;
  box-shadow: 0 16rpx 28rpx rgba(251, 146, 60, 0.22);
}

.cool-btn {
  background: #0f766e;
  box-shadow: 0 16rpx 28rpx rgba(15, 118, 110, 0.2);
}

.ghost-btn {
  background: #f1f5f9;
  color: #0f172a;
}

.subtle-btn {
  background: rgba(255, 255, 255, 0.9);
}

.picker-field,
.text-input,
.text-area {
  width: 100%;
  margin-top: 14rpx;
  background: rgba(248, 250, 252, 0.96);
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.compact-area {
  min-height: 88rpx;
}

.text-area {
  min-height: 168rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.search-shell {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  font-size: 26rpx;
  color: #0f172a;
}

.search-clear {
  flex-shrink: 0;
  min-width: 120rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
}

.result-card {
  margin-top: 18rpx;
  border-radius: 24rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(251, 146, 60, 0.18);
}

.result-card.accent {
  border-color: rgba(34, 211, 238, 0.22);
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.result-meta,
.result-desc,
.food-desc,
.record-meta,
.summary-row,
.empty-text,
.food-chip-meta {
  margin-top: 8rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.6;
}

.summary-row:first-child {
  margin-top: 14rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.food-chip {
  width: calc(50% - 8rpx);
  border-radius: 20rpx;
  padding: 18rpx;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  border: 1rpx solid #e2e8f0;
}

.food-chip-title,
.food-name,
.record-title,
.planner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 2rpx;
}

.result-count {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 24rpx;
}

.record-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.record-month-label {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.record-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.strong-row {
  color: #334155;
  font-weight: 600;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
}

.calendar-weekdays {
  color: #64748b;
  font-size: 22rpx;
  text-align: center;
  margin-bottom: 10rpx;
}

.calendar-day {
  min-height: 118rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  padding: 12rpx;
}

.calendar-day.blank {
  background: transparent;
  border-color: transparent;
}

.calendar-day.has-records {
  background: linear-gradient(180deg, #fff7ed, #ffffff);
  border-color: #fdba74;
}

.calendar-day.selected {
  border-color: #0ea5e9;
  box-shadow: 0 0 0 2rpx rgba(14, 165, 233, 0.12);
}

.calendar-day-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.calendar-day-count {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a3412;
}

.calendar-day-preview {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #475569;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.day-record-card {
  margin-top: 16rpx;
}

.food-card,
.record-card,
.custom-item,
.planner-card {
  padding: 22rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.food-top-row,
.record-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.food-calories {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 700;
}

.food-badges,
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.food-card-main,
.custom-main {
  position: relative;
}

.food-card-main::after,
.custom-main::after {
  content: '';
  position: absolute;
  left: -22rpx;
  right: -22rpx;
  bottom: -18rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(251, 146, 60, 0), rgba(251, 146, 60, 0.18), rgba(14, 165, 233, 0.18), rgba(14, 165, 233, 0));
}

.badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
}

.badge-fav {
  background: #ffe4e6;
  color: #be123c;
}

.food-actions,
.row-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.mini-btn {
  flex: 1;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 24rpx;
  line-height: 74rpx;
  padding: 0;
}

.mini-btn-active {
  background: #ffedd5;
  color: #c2410c;
}

.danger-btn {
  color: #b91c1c;
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
}

.detail-panel {
  width: 100%;
  max-height: 86vh;
  overflow: auto;
  background: linear-gradient(180deg, #fffdf8, #ffffff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 28rpx 40rpx;
  box-shadow: 0 24rpx 56rpx rgba(15, 23, 42, 0.18);
}

.detail-close {
  text-align: right;
  color: #64748b;
  font-size: 24rpx;
}

.detail-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-subtitle {
  margin-top: 12rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.7;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detail-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f8fafc, #ffffff);
  border: 1rpx solid #e2e8f0;
}

.detail-edit-area {
  min-height: 140rpx;
  margin-top: 10rpx;
  background: #ffffff;
}

.detail-label {
  margin-bottom: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.step-row {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.6;
}
