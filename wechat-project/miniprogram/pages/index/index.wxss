.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 168rpx;
  background:
    radial-gradient(circle at top, rgba(254, 243, 199, 0.95), rgba(248, 250, 252, 0) 42%),
    linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);
}

.page-shell.modal-open {
  height: 100vh;
  overflow: hidden;
}

button {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.button-hover {
  transform: scale(0.9);
  opacity: 0.92;
}

.backdrop {
  position: fixed;
  border-radius: 999rpx;
  filter: blur(12rpx);
  opacity: 0.32;
  pointer-events: none;
}

.backdrop-one {
  top: 120rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  background: #fde68a;
}

.backdrop-two {
  top: 520rpx;
  left: -100rpx;
  width: 280rpx;
  height: 280rpx;
  background: #bfdbfe;
}

.hero,
.card,
.overview-card,
.feature-card,
.bottom-tabbar {
  position: relative;
  z-index: 1;
}

.hero {
  background: linear-gradient(135deg, #fff7ed, #e0f2fe);
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 24rpx 56rpx rgba(15, 23, 42, 0.08);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.hero-copy {
  flex: 1;
  min-height: 24rpx;
}

.hero-eyebrow,
.section-eyebrow {
  color: #64748b;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #0f172a;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.6;
}

.hero-badge {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-status {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.hero-status-item {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.hero-status-label {
  color: #64748b;
  font-size: 22rpx;
}

.hero-status-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.overview-card,
.card,
.feature-card {
  margin-top: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(10rpx);
}

.feature-warm {
  background: linear-gradient(180deg, rgba(255, 251, 235, 0.96), rgba(255, 255, 255, 0.96));
}

.feature-cool {
  background: linear-gradient(180deg, rgba(236, 254, 255, 0.96), rgba(255, 255, 255, 0.96));
}

.soft-card {
  background: linear-gradient(180deg, #fffdf7, #f8fbff);
}

.premium-card {
  border-color: rgba(226, 232, 240, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.07);
}

.feature-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #0f172a;
}

.section-desc {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.feature-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 700;
}

.feature-tag.cool {
  background: #cffafe;
  color: #0f766e;
}

.section-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: 36rpx;
}

.home-subtab-shell {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.home-subtab-rail {
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  flex: 0 0 88rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  position: relative;
  overflow: hidden;
}

.home-subtab-btn {
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  color: #475569;
  font-size: 20rpx;
  line-height: 64rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: clip;
  flex: 0 0 88rpx;
}

.home-subtab-btn.active {
  background: linear-gradient(180deg, #fff7ed, #ffedd5);
  border-color: #fdba74;
  color: #9a3412;
  font-weight: 700;
}

.home-subtab-btn::after {
  border: none;
}

.home-subtab-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.home-pane-card {
  margin-top: 0;
}

.home-pane-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.overview-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.overview-item {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fffaf5, #ffffff);
  border: 1rpx solid #e2e8f0;
  text-align: center;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}

.overview-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.primary-btn,
.ghost-btn {
  width: 100%;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 90rpx;
  margin-top: 14rpx;
}

.primary-btn {
  background: #fb923c;
  color: #ffffff;
  box-shadow: 0 16rpx 28rpx rgba(251, 146, 60, 0.22);
}

.cool-btn {
  background: #0f766e;
  box-shadow: 0 16rpx 28rpx rgba(15, 118, 110, 0.2);
}

.ghost-btn {
  background: #f1f5f9;
  color: #0f172a;
}

.subtle-btn {
  background: rgba(255, 255, 255, 0.9);
}

.picker-field,
.text-input,
.text-area {
  width: 100%;
  margin-top: 14rpx;
  background: rgba(248, 250, 252, 0.96);
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.compact-area {
  min-height: 88rpx;
}

.compact-input {
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}

.text-area {
  min-height: 168rpx;
}

.no-top {
  margin-top: 0;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.search-shell {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  font-size: 26rpx;
  color: #0f172a;
}

.search-clear {
  flex-shrink: 0;
  min-width: 120rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
}

.result-card {
  margin-top: 18rpx;
  border-radius: 24rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(251, 146, 60, 0.18);
}

.result-card.accent {
  border-color: rgba(34, 211, 238, 0.22);
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.result-meta,
.result-desc,
.food-desc,
.record-meta,
.summary-row,
.empty-text,
.food-chip-meta {
  margin-top: 8rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.6;
}

.summary-row:first-child {
  margin-top: 14rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.food-chip {
  width: calc(50% - 8rpx);
  border-radius: 20rpx;
  padding: 18rpx;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  border: 1rpx solid #e2e8f0;
}

.food-chip-title,
.food-name,
.record-title,
.planner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.food-name {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
  line-height: 1.4;
  word-break: break-all;
}

.food-list {
  display: grid;
  gap: 18rpx;
  margin-top: 2rpx;
}

.food-grid-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
}

.result-count {
  grid-column: 1 / -1;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 24rpx;
}

.record-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.record-month-label {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.record-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.strong-row {
  color: #334155;
  font-weight: 600;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
}

.calendar-weekdays {
  color: #64748b;
  font-size: 22rpx;
  text-align: center;
  margin-bottom: 10rpx;
}

.calendar-day {
  min-height: 118rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  padding: 12rpx;
}

.calendar-day.blank {
  background: transparent;
  border-color: transparent;
}

.calendar-day.has-records {
  background: linear-gradient(180deg, #fff7ed, #ffffff);
  border-color: #fdba74;
}

.calendar-day.selected {
  border-color: #0ea5e9;
  box-shadow: 0 0 0 2rpx rgba(14, 165, 233, 0.12);
}

.calendar-day-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.calendar-day-count {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a3412;
}

.calendar-day-preview {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #475569;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.day-record-card {
  margin-top: 0;
}

.food-card,
.record-card,
.custom-item,
.planner-card {
  padding: 22rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.food-top-row,
.record-main,
.food-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.food-card-header {
  margin-bottom: 10rpx;
  display: block;
}

.food-card-title-row {
  display: flex;
  align-items: flex-start;
}

.food-card-title {
  flex: 1;
  min-width: 0;
}

.food-card-meta-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.food-calories,
.food-calorie-line {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #9a3412;
  font-size: 20rpx;
  font-weight: 700;
  max-width: 100%;
}

.food-calorie-line {
  margin-top: 0;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.favorite-badge {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ffe4e6;
  color: #be123c;
  font-size: 20rpx;
  font-weight: 700;
}

.collect-chip {
  width: 66rpx;
  min-width: 66rpx;
  max-width: 66rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 18rpx;
  text-align: center;
  margin: 0;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.collect-chip::after,
.choice-pill::after,
.step-remove-btn::after,
.record-delete-btn::after {
  border: none;
}

.collect-chip.active {
  background: #ffe4e6;
  color: #be123c;
}

.spinner-add-chip {
  min-width: 66rpx;
  width: auto;
  padding: 0 12rpx;
  background: #ecfeff;
  color: #0f766e;
}

.spinner-add-chip.active {
  background: #dcfce7;
  color: #15803d;
}

.food-description {
  min-height: 72rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.5;
}

.food-badges,
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.badge-type {
  background: rgba(251, 146, 60, 0.14);
  color: #c2410c;
}

.badge-traffic {
  background: rgba(14, 165, 233, 0.12);
  color: #0369a1;
}

.badge-season {
  background: rgba(16, 185, 129, 0.12);
  color: #047857;
}

.badge-date {
  background: rgba(124, 58, 237, 0.12);
  color: #6d28d9;
}

.nutrients-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.nutrient-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #475569;
  font-size: 22rpx;
}

.food-card-main,
.custom-main {
  position: relative;
}

.food-card-main::after,
.custom-main::after {
  content: '';
  position: absolute;
  left: -22rpx;
  right: -22rpx;
  bottom: -18rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(251, 146, 60, 0), rgba(251, 146, 60, 0.18), rgba(14, 165, 233, 0.18), rgba(14, 165, 233, 0));
}

.badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
}

.badge-fav {
  background: #ffe4e6;
  color: #be123c;
}

.spinner-pool-panel {
  margin-top: 14rpx;
}

.spinner-chip-group {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spinner-food-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  border: 1rpx solid #e2e8f0;
}

.spinner-food-row.active {
  background: linear-gradient(180deg, #fff7ed, #ffedd5);
  border-color: #fdba74;
}

.spinner-check-wrap {
  width: 36rpx;
  min-width: 36rpx;
  height: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36rpx;
}

.spinner-check-wrap .choice-check {
  width: 26rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  font-size: 18rpx;
}

.spinner-check-wrap.active .choice-check {
  border-color: #f97316;
  background: #f97316;
  color: #ffffff;
}

.spinner-food-name {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 4rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spinner-remove-wrap {
  width: 36rpx;
  min-width: 36rpx;
  height: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36rpx;
  border-radius: 999rpx;
  background: #fff1f2;
}

.spinner-remove-mark {
  color: #be123c;
  font-size: 24rpx;
  line-height: 1;
}

.confirm-pick-btn {
  margin-top: 16rpx;
  background: #ea580c;
  box-shadow: 0 16rpx 28rpx rgba(234, 88, 12, 0.24);
}

.confirm-pick-btn.disabled {
  background: #cbd5e1;
  color: #475569;
  box-shadow: none;
}

.food-actions,
.row-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.food-actions {
  flex-wrap: wrap;
  justify-content: flex-end;
}

.mini-btn {
  flex: 1;
  min-width: 0;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 24rpx;
  line-height: 74rpx;
  padding: 0;
}

.mini-btn-active {
  background: #ffedd5;
  color: #c2410c;
}

.danger-btn {
  color: #b91c1c;
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-panel {
  width: 100%;
  max-width: 680rpx;
  max-height: calc(100vh - 72rpx);
  overflow: auto;
  background: linear-gradient(180deg, #fffdf8, #ffffff);
  border-radius: 32rpx;
  padding: 30rpx 28rpx 40rpx;
  box-shadow: 0 24rpx 56rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
  margin: auto 0;
}

.detail-close {
  text-align: right;
  color: #64748b;
  font-size: 24rpx;
}

.detail-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-subtitle {
  margin-top: 12rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.7;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detail-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f8fafc, #ffffff);
  border: 1rpx solid #e2e8f0;
}

.detail-edit-area {
  min-height: 140rpx;
  margin-top: 10rpx;
  background: #ffffff;
}

.detail-label {
  margin-bottom: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.step-row {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.6;
}

.double-input-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 14rpx;
}

.tight-grid {
  margin-top: 10rpx;
}

.form-section-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 700;
}

.choice-group {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice-group.compact {
  margin-top: 12rpx;
}

.choice-pill {
  margin: 0;
  padding: 14rpx 22rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #475569;
  font-size: 24rpx;
}

.choice-pill.active {
  background: #ffedd5;
  border-color: #fb923c;
  color: #c2410c;
}

.checkbox-pill {
  min-width: 160rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  display: inline-flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  background: #ffffff;
  cursor: pointer;
}

.checkbox-pill.active {
  background: #fff7ed;
  border-color: #fb923c;
  color: #9a3412;
  box-shadow: inset 0 0 0 2rpx rgba(251, 146, 60, 0.18);
}

.checkbox-pill checkbox {
  transform: scale(0.9);
  transform-origin: left center;
}

.choice-check {
  width: 28rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  color: transparent;
  font-size: 20rpx;
  text-align: center;
}

.checkbox-pill.active .choice-check {
  border-color: #f97316;
  background: #f97316;
  color: #ffffff;
}

.choice-label {
  line-height: 1.3;
}

.record-add-panel {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compact-search-shell {
  margin-top: 0;
}

.compact-search-input {
  height: 72rpx;
  font-size: 24rpx;
}

.compact-action-btn {
  margin-top: 0;
}

.saved-food-summary {
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff7ed, #fff);
  border: 1rpx solid #fed7aa;
}

.saved-food-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #9a3412;
}

.saved-food-tip {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.custom-saved-grid,
.day-record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 16rpx;
}

.step-editor-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-editor-card {
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fff, #f8fafc);
  border: 1rpx solid #e2e8f0;
}

.step-editor-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.step-editor-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
}

.step-remove-btn {
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 22rpx;
}

.step-detail-area {
  min-height: 120rpx;
  margin-top: 12rpx;
}

.step-add-btn {
  margin-top: 16rpx;
}

.planner-day-block {
  grid-column: 1 / -1;
}

.planner-day-title {
  margin: 6rpx 0 14rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.planner-day-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.toolbar-btn {
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 22rpx;
}

.ghost-toolbar-btn {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.danger-toolbar-btn {
  color: #b91c1c;
}

.record-action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.record-delete-btn {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 40rpx;
  text-align: center;
  margin-left: auto;
  margin-right: 0;
}

.planner-grid .food-chip {
  width: 100%;
}

.food-chip {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.food-grid-list .food-card,
.custom-saved-grid .custom-item,
.day-record-grid .record-card {
  height: 100%;
}

.day-record-grid .record-main {
  display: block;
}

.bottom-tabbar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(16rpx);
}

.bottom-tab-item {
  padding: 16rpx 8rpx;
  border-radius: 22rpx;
  text-align: center;
  color: #64748b;
  background: transparent;
}

.bottom-tab-item.active {
  background: linear-gradient(135deg, #fff1d6, #e0f2fe);
  color: #0f172a;
  box-shadow: inset 0 0 0 1rpx rgba(251, 146, 60, 0.24);
}

.bottom-tab-label {
  font-size: 24rpx;
  font-weight: 700;
}
